# Base URL of the LetzAI public API the tools call.
LETZAI_API_BASE_URL=https://api.letz.ai

# Port the MCP server listens on.
PORT=3010

# Max time (ms) to poll a generation before giving up.
LETZAI_POLL_TIMEOUT_MS=180000

# --- OAuth (connect without an API key) ---------------------------------------------------
# Off by default. Switch on ONLY after the LetzAI API's authorization server is on
# (OAUTH_SERVER_ENABLED there): advertising OAuth the API cannot serve sends every client into
# a discovery flow that ends in a 404. With this off, the server behaves exactly as it always
# has — bearer API keys only.
LETZAI_OAUTH_ENABLED=false

# This server's canonical URI. Must equal, character for character, the URL users type into
# their MCP client, and must be listed in the API's OAUTH_ALLOWED_RESOURCES.
LETZAI_MCP_RESOURCE_URI=https://mcp.letz.ai/mcp

# Issuer of the authorization server. Defaults to LETZAI_API_BASE_URL.
# LETZAI_AUTHORIZATION_SERVER=https://api.letz.ai

# How long (ms) a successful token check is reused. A revoked connection stops working here
# within this window — and immediately at the API, which re-checks every call.
LETZAI_OAUTH_TOKEN_CACHE_TTL_MS=60000
